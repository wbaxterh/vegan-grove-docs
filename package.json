{
  "name": "vegan-grove-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Technical documentation for the Vegan Grove platform",
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "typecheck": "tsc",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "pokedocs check",
    "validate": "npm run lint && npm run typecheck && npm run check && npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "@pokedocs/preset": "^0.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "pokedocs": "^0.2.0",
    "secretlint": "^13.0.5",
    "typescript": "~7.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,css}": "biome check --write",
    "*": "secretlint"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=24"
  }
}
